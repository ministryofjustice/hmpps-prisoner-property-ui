{% extends "../../partials/layout.njk" %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "../../partials/paperPropertyCards.njk" import paperPropertyCards %}

{% set pageTitle = applicationName + " - Check your answers" %}
{% set mainClasses = "govuk-body" %}

{% set detailsUrl = "/prisoner/" + prisonerNumber + "/add-container/details" %}

{% block beforeContent %}
  {{ govukBackLink({ text: "Back", href: backUrl }) }}
{% endblock %}

{% block content %}
  {# The journey can carry several containers, so the heading and button follow the count. #}
  {% set containerNoun = "property container" if containers.length == 1 else "property containers" %}
  <h1 class="govuk-heading-xl" data-qa="check-answers-heading">Check your answers before adding the {{ containerNoun }}</h1>

  {{ govukSummaryList({
    attributes: { "data-qa": "prisoner-summary" },
    rows: [
      { key: { text: "Name" }, value: { text: (prisonerName | convertToTitleCase) or "Unknown" } },
      { key: { text: "Prison number" }, value: { text: prisonerNumber } },
      { key: { text: "Establishment" }, value: { text: establishmentName or "Not known" } }
    ]
  }) }}

  {% for container in containers %}
    <h2 class="govuk-heading-m govuk-!-margin-top-6">
      Property container {{ container.sealNumber }}
      <span class="govuk-!-font-weight-regular govuk-!-font-size-19 govuk-!-margin-left-3">
        <a class="govuk-link" href="{{ detailsUrl }}#containers-{{ container.index }}-sealNumber" data-qa="change-{{ container.index }}">Change<span class="govuk-visually-hidden"> property container {{ container.sealNumber }}</span></a>
      </span>
    </h2>

    {# The previous seal is only shown when one was entered - it decides whether this record gets matched to
       the property's record at the establishment it came from, so staff need to see it before confirming. #}
    {% set sealRows = [
      { key: { text: "Seal number" }, value: { text: container.sealNumber } }
    ] %}
    {% if container.previousSealNumber %}
      {% set sealRows = (sealRows.push({
        key: { text: "Previous seal number" },
        value: { text: container.previousSealNumber },
        actions: { items: [{ href: detailsUrl + "#containers-" + container.index + "-previousSealNumber", text: "Change", visuallyHiddenText: "previous seal number" }] }
      }), sealRows) %}
    {% endif %}

    {{ govukSummaryList({
      attributes: { "data-qa": "container-summary" },
      rows: sealRows.concat([
        { key: { text: "Property type" }, value: { text: container.containerType | containerTypeLabel } },
        { key: { text: "Disposal date" }, value: { text: (container.proposedDisposalDate | formatDate) if container.proposedDisposalDate else "Not provided" } },
        { key: { text: "Storage location" }, value: { text: container.storageLocation or "Not set" } },
        { key: { text: "Property status" }, value: { html: govukTag({ text: "Stored", classes: "govuk-tag--green" }) } }
      ])
    }) }}
  {% endfor %}

  {{ paperPropertyCards() }}

  <form method="post" action="/prisoner/{{ prisonerNumber }}/add-container/confirm">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    {{ govukButton({ text: "Add " + containerNoun, attributes: { "data-qa": "confirm" } }) }}
  </form>

  <p class="govuk-body"><a class="govuk-link" href="/prisoner/{{ prisonerNumber }}" data-qa="cancel">Cancel</a></p>
{% endblock %}
