{% extends "../partials/layout.njk" %}

{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "components/pagination/macro.njk" import mojPagination %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% set pageTitle = applicationName + " - Property" %}
{% set mainClasses = "govuk-body" %}

{% block beforeContent %}
  {{ govukBreadcrumbs({ items: [
    { text: "Digital Prison Services", href: dpsUrl }
  ] }) }}
{% endblock %}

{% block content %}
  {% if successMessage %}
    {{ govukNotificationBanner({
      type: "success",
      text: successMessage,
      attributes: { "data-qa": "success-banner" }
    }) }}
  {% endif %}

  {% include "../partials/nomisBanner.njk" %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">Prisoner property</h1>
    </div>
    {% if isLocationAdmin %}
      <div class="govuk-grid-column-one-third govuk-!-text-align-right">
        {{ govukButton({
          text: "Manage storage locations",
          href: "/admin/locations",
          classes: "govuk-button--secondary",
          attributes: { "data-qa": "manage-locations-link" }
        }) }}
      </div>
    {% endif %}
  </div>

  {% if canManage %}
    {{ govukButton({
      text: "Add a property container",
      href: "/add-container",
      attributes: { "data-qa": "add-container" }
    }) }}
  {% endif %}

  {% if isAdmin %}
    <p class="govuk-body">
      <a class="govuk-link" href="/admin/prisons" data-qa="manage-prisons-link">Manage enabled prisons</a>
    </p>
  {% endif %}

  {% if summary %}
    {% set tiles = [
      { text: "Available storage spaces on site", value: summary.availableStorageSpaces, qa: "summary-available-spaces" },
      { text: "Containers stored on site", value: summary.storedOnSite, qa: "summary-stored" },
      { text: "Containers due to be transferred out", value: summary.dueToTransferOut, qa: "summary-transfer-out" },
      { text: "Containers due to be returned", value: summary.dueToBeReturned, qa: "summary-returned" },
      { text: "Containers due to be disposed of", value: summary.dueToBeDisposed, qa: "summary-disposed" }
    ] %}
    <div class="property-summary" data-qa="property-summary">
      {% for tile in tiles %}
        <div class="property-summary__card">
          <p class="property-summary__caption">{{ tile.text }}</p>
          <p class="property-summary__value" data-qa="{{ tile.qa }}">{{ tile.value | formatNumber }}</p>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  <div class="app-search-panel">
    <form method="get" action="/" novalidate data-qa="property-search">
      <h2 class="govuk-heading-m">Search for property</h2>
      <p class="govuk-hint">Search by prison number, seal number or storage location.</p>

      <div class="app-search-panel__row">
        {{ govukInput({
          label: { text: "Search for property", classes: "govuk-visually-hidden" },
          id: "q",
          name: "q",
          value: search,
          classes: "govuk-input--width-20",
          formGroup: { classes: "app-search-panel__input" }
        }) }}
        {{ govukButton({ text: "Search", classes: "app-search-panel__button" }) }}
        <a class="govuk-link app-search-panel__clear" href="/?clear=1" data-qa="clear-search">Clear search</a>
      </div>

      {% if appliedFilters | length %}
        {# The filters below are collapsed by default and persist between visits, so without this nothing on
           screen says the list is filtered - or what it is filtered on. #}
        <div class="app-search-panel__selected" data-qa="selected-filters">
          <div class="app-search-panel__selected-header">
            <h3 class="govuk-heading-s govuk-!-margin-bottom-1">Selected filters</h3>
            <a class="govuk-link" href="{{ clearFiltersHref }}" data-qa="clear-all-filters">Clear filters</a>
          </div>
          <ul class="moj-filter-tags">
            {% for filter in appliedFilters %}
              <li>
                <a class="moj-filter__tag" href="{{ filter.href }}" data-qa="selected-filter">
                  <span class="govuk-visually-hidden">Remove this filter:</span> {{ filter.text }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      <details class="govuk-details app-search-panel__filters" data-qa="filters">
        <summary class="govuk-details__summary">
          <span class="govuk-details__summary-text">Filters</span>
        </summary>
        <div class="govuk-details__text">
          {{ govukCheckboxes({
            idPrefix: "containerType",
            name: "containerType",
            classes: "govuk-checkboxes--small app-checkboxes--inline",
            fieldset: { legend: { text: "Property type", classes: "govuk-fieldset__legend--s" } },
            items: containerTypeItems
          }) }}

          {{ govukCheckboxes({
            idPrefix: "status",
            name: "status",
            classes: "govuk-checkboxes--small app-checkboxes--inline",
            fieldset: { legend: { text: "Property status", classes: "govuk-fieldset__legend--s" } },
            items: statusItems
          }) }}

          {{ govukCheckboxes({
            idPrefix: "personLocation",
            name: "personLocation",
            classes: "govuk-checkboxes--small app-checkboxes--inline",
            fieldset: { legend: { text: "Person’s location", classes: "govuk-fieldset__legend--s" } },
            items: personLocationItems
          }) }}

          {{ govukCheckboxes({
            idPrefix: "includeRemoved",
            name: "includeRemoved",
            classes: "govuk-checkboxes--small",
            fieldset: { legend: { text: "Property no longer held", classes: "govuk-fieldset__legend--s" } },
            items: [
              { value: "true", text: "Removed, returned or disposed of", checked: includeRemoved }
            ]
          }) }}

          {{ govukButton({ text: "Apply filters", attributes: { "data-qa": "apply-filters" } }) }}
          <a class="govuk-link govuk-!-margin-left-2" href="/?clear=1" data-qa="clear-filters">Clear filters</a>
        </div>
      </details>
    </form>
  </div>

  {% if groups.length == 0 %}
    <p class="govuk-body" data-qa="no-results">No property containers found.</p>
  {% else %}
    {% set tableHead = [
      { text: "Name" },
      { text: "Establishment" },
      { text: "Seal number" },
      { text: "Property type" },
      { text: "Storage location" },
      { text: "Last updated" },
      { text: "Property status" }
    ] %}
    {% if canManage %}
      {% set tableHead = (tableHead.push({ text: "Actions" }), tableHead) %}
    {% endif %}

    {% set rows = [] %}
    {% for group in groups %}
      {% for container in group.containers %}
        {% set statusData = container | establishmentListStatusTag(viewedPrisonId) %}
        {% set cells = [] %}
        {% if loop.first %}
          {% set nameHtml %}
            <a class="govuk-link" href="/prisoner/{{ group.prisonerNumber }}">{{ (group.prisonerName | convertToTitleCase) or "Unknown" }}</a>
            <div class="govuk-!-font-weight-regular">{{ group.prisonerNumber }}</div>
          {% endset %}
          {% set cells = (cells.push(
            { html: nameHtml, rowspan: group.containers.length, attributes: { "data-qa": "prisoner-heading" } },
            { text: group | establishmentLabel, rowspan: group.containers.length, attributes: { "data-qa": "prisoner-establishment" } }
          ), cells) %}
        {% endif %}
        {% set cells = (cells.push(
          { text: container.currentSealNumber or "-" },
          { text: container.containerType | containerTypeLabel },
          { text: container | containerLocation },
          { text: container.createDateTime | formatShortDate },
          { html: govukTag({ text: statusData.text, classes: statusData.classes }) }
        ), cells) %}
        {% if canManage %}
          {% if container.removalOutcome %}
            {% set cells = (cells.push({ text: "" }), cells) %}
          {% else %}
            {% set actionsHtml %}<a class="govuk-link" href="/prisoner/{{ group.prisonerNumber }}/change-container/{{ container.id }}?from=list" data-qa="manage-link">Manage<span class="govuk-visually-hidden"> {{ container.currentSealNumber }}</span></a>{% endset %}
            {% set cells = (cells.push({ html: actionsHtml }), cells) %}
          {% endif %}
        {% endif %}
        {% set rows = (rows.push(cells), rows) %}
      {% endfor %}
    {% endfor %}

    {{ mojPagination(pagination) }}

    {{ govukTable({
      classes: "govuk-!-font-size-16",
      attributes: { "data-qa": "property-list" },
      head: tableHead,
      rows: rows
    }) }}

    {{ mojPagination(pagination) }}
  {% endif %}
{% endblock %}
