REDIS_ENABLED=false
TOKEN_VERIFICATION_ENABLED=false

# Credentials for allowing user access
AUTH_CODE_CLIENT_ID=hmpps-prisoner-property
AUTH_CODE_CLIENT_SECRET=clientsecret

# Credentials for API calls
CLIENT_CREDS_CLIENT_ID=hmpps-prisoner-property-system
CLIENT_CREDS_CLIENT_SECRET=clientsecret

# Base URL of hmpps-prisoner-property-api
PRISONER_PROPERTY_API_URL=http://localhost:8080
MANAGE_USERS_API_URL=https://manage-users-api-dev.hmpps.service.justice.gov.uk

# Prisoner Search feeds the person banner; Prison API serves the prisoner photo. Both are required in
# production, and without them locally the banner and photo silently fall back to localhost.
PRISONER_SEARCH_API_URL=https://prisoner-search-dev.prison.service.justice.gov.uk
PRISON_API_URL=https://prison-api-dev.prison.service.justice.gov.uk

# DPS shared frontend-components + Digital Prison Services home
COMPONENT_API_URL=https://frontend-components-dev.hmpps.service.justice.gov.uk
DPS_URL=https://dps-dev.prison.service.justice.gov.uk
